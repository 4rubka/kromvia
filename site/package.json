    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "skinview3d": "3.4.2",
    "three": "0.156.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.156.0",
    "typescript": "^5",
    "wrangler": "4.156.2"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
