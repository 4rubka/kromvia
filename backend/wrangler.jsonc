{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kromvia-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "10ab8dc6c45c1dc91af42fc1ce87515b",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kromvia",
      "database_id": "789852e9-eb2d-4a9b-803d-cefe09e31044",
      "migrations_dir": "migrations"
    }
  ],
  // Per client network (IP, or /64 for IPv6), checked on every request.
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // Shared screenshots, under screenshots/<share code>.
  "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "kromvia-shots" }],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "routes": [{ "pattern": "api.kromvia.com", "custom_domain": true }],
  // The site lives on kromvia.com; the API only answers on its own subdomain.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
